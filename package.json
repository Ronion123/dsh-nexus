{
  "name": "@roninxr/dsh-nexus",
  "version": "1.4.4",
  "description": "奈克赛斯桌宠：红色与蓝色青年形态两套素材，支持单向形态转换，由 Q 版循环动画、九格动作组与透明姿势立绘组成的 dsh-pet 种类包。",
  "type": "module",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "Ronin",
  "homepage": "https://github.com/Ronion123/dsh-nexus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ronion123/dsh-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/Ronion123/dsh-nexus/issues"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "pet-pack"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "dsh-pet",
    "pet-pack",
    "nexus",
    "桌宠"
  ]
}
